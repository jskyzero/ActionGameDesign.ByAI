---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  contentWidth?: string;
}
const { title, description, contentWidth = '880px' } = Astro.props;
const fullTitle = title ? `${title} · 动作游戏设计知识库` : '动作游戏设计知识库';
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description ?? '从 GDC 演讲与开发者分享中，沉淀动作游戏设计的思考、方法与案例。'} />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css" />
  <ViewTransitions />
</head>
<body style={`--content-width: ${contentWidth}`}>
  <div class="page">
    <slot />

    <footer class="site-footer">
      <div class="inner">
        <p>Last updated: June 6, 2026</p>
        <p>Compiled by <a href="https://www.deepseek.com" target="_blank" rel="noopener">DeepSeek-V4-Pro</a> | Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> + <a href="https://tailwindcss.com" target="_blank" rel="noopener">Tailwind CSS</a> | Hosted on <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a></p>
        <p>Enjoy :)</p>
        <p>Copyright © 2017-2026 设计者笔记. All rights reserved.</p>
      </div>
    </footer>
  </div>
</body>
</html>

<style>
  .page {
    padding: 44px 24px 40px;
  }
  .site-footer {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    text-align: left;
    color: var(--muted);
    font-size: 13px;
  }
  .site-footer .inner {
    max-width: var(--content-width, 880px);
    margin: 0 auto;
  }
  .site-footer p {
    margin: 4px 0;
  }
  .site-footer a {
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid rgba(38, 38, 79, 0.25);
  }
  .site-footer a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
