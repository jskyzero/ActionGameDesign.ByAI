---
interface Props {
  markdown: string;
}
const { markdown = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---

<div class="cm" data-cm={uid}>
  <svg id={`cm-svg-${uid}`} class="cm-svg"></svg>
  <pre id={`cm-src-${uid}`} hidden>{markdown}</pre>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/markmap-lib@0.18.12/dist/browser/index.iife.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/markmap-view@0.18.12/dist/browser/index.js"></script>

<style is:global>
  .cm { margin: 1rem 0 1.5rem; border: 1px solid #eee; border-radius: 10px; background: #fff; overflow: hidden; }
  .cm-svg { width: 100%; height: 480px; display: block; }
  .cm .markmap {
    --markmap-font: 400 14px/1.5 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
    --markmap-text-color: #3a3a4a;
    --markmap-max-width: 9999px;
  }
  .cm .markmap-link { fill: none; stroke-linecap: round; stroke-linejoin: round; opacity: 0.9; }
  .cm .markmap-node > circle { display: none; }
  .cm .markmap-foreign { display: inline-block; }
  .cm .markmap-foreign p { margin: 0; }
  .cm .mm-card {
    display: inline-block; box-sizing: border-box; border-radius: 8px;
    border: 1.5px solid #e7e7f0; line-height: 1.5; white-space: nowrap;
  }
  .cm .mm-root {
    background-color: #1f2766; color: #fff; font-weight: 600; font-size: 15px;
    padding: 10px 20px; border-radius: 11px; border: 2px solid #1f2766;
    box-shadow: 0 3px 10px rgba(31,39,102,.2);
  }
  .cm .mm-main { font-weight: 600; font-size: 14.5px; padding: 7px 16px; }
  .cm .mm-sub { font-weight: 500; font-size: 13.5px; color: #23232f; background: #fbfbfd; border-color: #e7e7f0; padding: 5px 14px; }
  .cm .mm-note { font-size: 13px; color: #6a6a7a; background: #fff; border-color: #f0f0f6; padding: 5px 14px; }
</style>

<script is:inline>
  (function () {
    const palette = ['#fa8155', '#ffad36', '#b7c82b', '#0098b9', '#7574bc', '#a165a8'];
    const rootColor = '#1f2766';

    function tint(hex, a) {
      const n = parseInt(hex.slice(1), 16);
      const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
      return `rgba(${r},${g},${b},${a})`;
    }

    function renderAll() {
      if (!window.markmap || !window.d3) return;
      document.querySelectorAll('.cm').forEach((wrap) => {
        if (wrap.dataset.done) return;
        wrap.dataset.done = '1';
        const id = wrap.dataset.cm;
        const src = document.getElementById('cm-src-' + id).textContent;
        const svg = document.getElementById('cm-svg-' + id);
        if (!src.trim() || !svg) return;

        const { Transformer, Markmap } = window.markmap;
        const linkShape = d3.linkHorizontal();
        const { root } = new Transformer().transform(src);

        let seq = 0;
        (function decorate(node, depth) {
          if (depth === 0) node.content = `<div class="mm-card mm-root">${node.content}</div>`;
          else if (depth === 1) {
            const c = palette[seq++ % palette.length];
            node.content = `<div class="mm-card mm-main" style="color:${c};border-color:${tint(c,0.55)};background:${tint(c,0.10)}">${node.content}</div>`;
          } else if (depth === 2) node.content = `<div class="mm-card mm-sub">${node.content}</div>`;
          else node.content = `<div class="mm-card mm-note">${node.content}</div>`;
          (node.children || []).forEach((c) => decorate(c, depth + 1));
        })(root, 0);

        const branchOrd = new Map();
        let nextOrd = 0;
        const lineColor = (d) => {
          const depth = d.state && d.state.depth;
          if (!depth || depth <= 1) return rootColor;
          const bid = (d.state.path || '').split('.')[1];
          if (!branchOrd.has(bid)) branchOrd.set(bid, nextOrd++);
          return palette[branchOrd.get(bid) % palette.length];
        };

        const mm = new Markmap(svg, {
          color: lineColor,
          lineWidth: () => 2,
          autoFit: true,
          fitRatio: 0.9,
          initialExpandLevel: -1,
          zoom: true,
          pan: true,
          duration: 0,
          paddingX: 16,
          spacingHorizontal: 80,
          spacingVertical: 12,
          nodeMinHeight: 30,
        });

        function centerAnchors() {
          svg.querySelectorAll('path.markmap-link').forEach((p) => {
            const d = p.__data__;
            if (!d || !d.source || !d.target) return;
            const s = d.source.state && d.source.state.rect;
            const t = d.target.state && d.target.state.rect;
            if (!s || !t) return;
            const dd = linkShape({ source: [s.x + s.width, s.y + s.height / 2], target: [t.x, t.y + t.height / 2] });
            if (p.getAttribute('d') !== dd) p.setAttribute('d', dd);
          });
          svg.querySelectorAll('g.markmap-node').forEach((g) => {
            const d = g.__data__;
            if (!d || !d.state || !d.state.rect) return;
            const h = d.state.rect.height;
            const line = g.querySelector('line');
            if (line) { if (line.getAttribute('y1') !== String(h/2)) line.setAttribute('y1', h/2); if (line.getAttribute('y2') !== String(h/2)) line.setAttribute('y2', h/2); }
            const c = g.querySelector('circle');
            if (c && c.getAttribute('cy') !== String(h/2)) c.setAttribute('cy', h/2);
          });
        }

        mm.setData(root).then(() => centerAnchors());
        const mo = new MutationObserver(() => requestAnimationFrame(centerAnchors));
        mo.observe(svg, { attributes: true, subtree: true, attributeFilter: ['d','y1','y2','cy'] });
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', renderAll);
    else renderAll();
    // markmap 的 CDN 脚本可能尚未就绪，稍作重试
    if (!window.markmap) setTimeout(renderAll, 300), setTimeout(renderAll, 1200);
  })();
</script>
