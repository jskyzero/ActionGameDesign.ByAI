---
interface Props {
  title: string;
  description?: string;
  tags?: { label: string; icon?: string }[];
  source?: { title?: string; author?: string; url?: string; year?: number | string; type?: string; company?: string };
  transitionName?: string;
}
const { title, description, tags = [], source, transitionName } = Astro.props;
const top = [source?.year ?? '年份不详', source?.type, source?.company].filter(Boolean).join(' · ');
---

<header class="hero" style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>
  {top && <div class="meta-top">{top}</div>}
  <h1><span class="title-hl">{title}</span></h1>
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((t) => <span class="tag">{t.icon ? `${t.icon} ` : ''}{t.label}</span>)}
    </div>
  )}
  {description && <p class="sub">{description}</p>}
</header>

<style>
  .hero {
    margin: 8px 0 36px;
  }
  .meta-top {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 14px;
    letter-spacing: 0.5px;
    color: var(--ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 12px;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 4px 12px;
    border-radius: var(--r-pill);
  }
  .sub {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
    margin: 14px 0 0;
  }
</style>
