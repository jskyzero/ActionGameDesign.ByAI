---
interface Props {
  title: string;
  event?: string;
  section?: string;
  year?: number;
  author?: string;
  role?: string;
  project?: string;
  transitionName?: string;
}
const { title, event, section, year, author, role, project, transitionName } = Astro.props;
const hasYear = typeof year === 'number';
const kicker = event
  ? event + (hasYear && !event.includes(String(year)) ? ` · ${year}` : '')
  : [section, hasYear ? String(year) : ''].filter(Boolean).join(' · ');
const bgText = event || section || '';
---

<header class="cover" style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>
  {bgText && <div class="cover-bg">{bgText}</div>}
  <div class="cover-body">
    {kicker && <div class="kicker">{kicker}</div>}
    <h1>{title}</h1>
    <div class="meta">
      {author && <span class="chip">👤 {author}</span>}
      {role && <span class="chip">🎨 {role}</span>}
      {project && <span class="chip">🎮 {project}</span>}
    </div>
  </div>
</header>

<style>
  .cover {
    position: relative;
    border-radius: var(--r-card);
    overflow: hidden;
    padding: 40px 38px 36px;
    color: var(--ink);
    background: var(--cover);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
  }
  .cover-bg {
    position: absolute;
    top: -12px;
    right: -6px;
    font-family: var(--font-serif);
    font-size: clamp(64px, 12vw, 140px);
    font-weight: 700;
    line-height: 1;
    color: rgba(38, 38, 79, 0.06);
    letter-spacing: -2px;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }
  .cover-body {
    position: relative;
  }
  .kicker {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .cover h1 {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 16px;
    letter-spacing: 0.5px;
    color: var(--ink);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--muted);
  }
</style>
