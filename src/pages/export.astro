---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://jskyzero.github.io';

const entries = (await getCollection('docs'))
  .filter((e) => e.id !== 'index.mdx' && !e.id.endsWith('/index.mdx'))
  .map((e) => {
    const d = e.data;
    const tags = (d.article.tags ?? [])
      .map((t) => `${t.icon ? t.icon + ' ' : ''}${t.label}`)
      .join(' / ');
    return {
      title: d.article.title,
      insight: d.article.insight ?? d.description ?? '',
      tags,
      sourceTitle: d.source?.title ?? '',
      url: d.source?.url ?? '',
      kbUrl: `${site}${base}/${e.slug}/`,
      year: d.source?.year,
    };
  })
  .sort((a, b) => {
    const av = typeof a.year === 'number' ? a.year : -Infinity;
    const bv = typeof b.year === 'number' ? b.year : -Infinity;
    return bv - av;
  });

const esc = (s) =>
  String(s ?? '')
    .replace(/\|/g, '\\|')
    .replace(/\r?\n/g, ' ')
    .trim();

function table(e) {
  return [
    '| 字段 | 内容 |',
    '| --- | --- |',
    `| 中文标题 | ${esc(e.title)} |`,
    `| 内容简介 | ${esc(e.insight)} |`,
    `| 标签 | ${esc(e.tags)} |`,
    `| 原文标题 | ${esc(e.sourceTitle)} |`,
    `| 原链接 | ${esc(e.url)} |`,
    `| 知识库链接 | ${esc(e.kbUrl)} |`,
  ].join('\n');
}
---

<Base title="Markdown 表格导出" contentWidth="880px">
  <div class="wrap">
    <header class="hero">
      <h1><span class="title-hl">Markdown 表格导出</span></h1>
      <p class="sub">每篇文章以可复制的 Markdown 表格呈现，共 {entries.length} 篇。</p>
    </header>

    {entries.map((e) => (
      <pre><code>{table(e)}</code></pre>
    ))}
  </div>
</Base>

<style>
  .wrap {
    max-width: var(--content-width);
    margin: 0 auto;
  }
  .hero {
    margin: 0 0 28px;
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: 1px;
    color: var(--ink);
  }
  .hero .sub {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
    margin: 0;
  }
  pre {
    margin: 0 0 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 16px 18px;
    overflow-x: auto;
    white-space: pre;
    font-size: 13px;
    line-height: 1.75;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    color: var(--ink);
  }
</style>
