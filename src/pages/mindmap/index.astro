---
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');

function add<K>(m: Map<K, any[]>, key: K, val: any) {
  if (!m.has(key)) m.set(key, []);
  m.get(key)!.push(val);
}

function buildMarkdown(dim: 'studio' | 'year' | 'tag' | 'kind'): string {
  const lines: string[] = ['# 动作游戏知识库'];

  if (dim === 'studio') {
    const groups = new Map<string, any[]>();
    for (const d of docs) {
      if (!d.id.startsWith('talks/')) continue;
      add(groups, d.data.studio ?? '未分类', d);
    }
    for (const [studio, items] of groups) {
      lines.push(`- ${studio}`);
      for (const it of items) {
        lines.push(`  - ${it.data.title}`);
        if (it.data.insight) lines.push(`    - ${it.data.insight}`);
      }
    }
  } else if (dim === 'year') {
    const groups = new Map<number, any[]>();
    for (const d of docs) {
      if (!d.id.startsWith('talks/') || d.data.year == null) continue;
      add(groups, d.data.year, d);
    }
    for (const [year, items] of [...groups.entries()].sort((a, b) => a[0] - b[0])) {
      lines.push(`- ${year}`);
      for (const it of items) {
        lines.push(`  - ${it.data.title.replace(/^\d{4}\s*·\s*/, '')}`);
        if (it.data.insight) lines.push(`    - ${it.data.insight}`);
      }
    }
  } else if (dim === 'tag') {
    const groups = new Map<string, any[]>();
    for (const d of docs) {
      if (!d.id.startsWith('talks/')) continue;
      for (const tag of d.data.tags ?? []) add(groups, tag, d);
    }
    for (const [tag, items] of [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0], 'zh'))) {
      lines.push(`- ${tag}`);
      for (const it of items) {
        lines.push(`  - ${it.data.title}`);
        if (it.data.insight) lines.push(`    - ${it.data.insight}`);
      }
    }
  } else {
    const talks = docs.filter((d) => d.id.startsWith('talks/'));
    const essays = docs.filter((d) => d.id.startsWith('essays/'));
    lines.push('- 分享索引（talk）');
    const sg = new Map<string, any[]>();
    for (const d of talks) add(sg, d.data.studio ?? '未分类', d);
    for (const [studio, items] of sg) {
      lines.push(`  - ${studio}`);
      for (const it of items) {
        lines.push(`    - ${it.data.title}`);
        if (it.data.insight) lines.push(`      - ${it.data.insight}`);
      }
    }
    if (essays.length) {
      lines.push('- 方法论文章（essay）');
      for (const e of essays) lines.push(`  - ${e.data.title}`);
    }
  }

  return lines.join('\n');
}

const data = {
  studio: buildMarkdown('studio'),
  year: buildMarkdown('year'),
  tag: buildMarkdown('tag'),
  kind: buildMarkdown('kind'),
};
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>思维导图 · 动作游戏知识库</title>
  <script is:inline src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/markmap-lib@0.18.12/dist/browser/index.iife.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/markmap-view@0.18.12/dist/browser/index.js"></script>
  <style is:global>
    :root {
      --xmind-bg: #ffffff;
      --xmind-root: #1f2766;
    }
    html, body { margin: 0; height: 100%; background: var(--xmind-bg); overflow: hidden; }
    #mindmap { width: 100vw; height: 100vh; display: block; }

    .markmap {
      --markmap-font: 400 15px/1.6 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
      --markmap-text-color: #3a3a4a;
      --markmap-max-width: 9999px;
    }
    .markmap-link {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.9;
    }
    .markmap-node > circle { display: none; }
    .markmap-foreign { display: inline-block; }
    .markmap-foreign p { margin: 0; }

    .mm-card {
      display: inline-block;
      box-sizing: border-box;
      border-radius: 9px;
      border: 1.5px solid #e7e7f0;
      line-height: 1.5;
      white-space: nowrap;
    }
    .mm-root {
      background-color: var(--xmind-root);
      color: #fff;
      font-weight: 600;
      font-size: 17px;
      padding: 13px 24px;
      border-radius: 12px;
      border: 2px solid var(--xmind-root);
      box-shadow: 0 3px 12px rgba(31, 39, 102, 0.22);
    }
    .mm-main {
      font-weight: 600;
      font-size: 16px;
      padding: 8px 18px;
    }
    .mm-sub {
      font-weight: 500;
      font-size: 15px;
      color: #23232f;
      background-color: #fbfbfd;
      border-color: #e7e7f0;
      padding: 6px 16px;
    }
    .mm-note {
      font-size: 14px;
      color: #6a6a7a;
      background-color: #ffffff;
      border-color: #f0f0f6;
      padding: 6px 16px;
    }

    .toolbar {
      position: fixed;
      top: 14px;
      left: 14px;
      z-index: 10;
      display: flex;
      gap: 6px;
      background: #fff;
      border: 1px solid #e7e7f0;
      border-radius: 10px;
      padding: 4px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }
    .toolbar button {
      appearance: none;
      border: 0;
      background: transparent;
      color: #6a6a7a;
      font: 500 13px/1 'PingFang SC', sans-serif;
      padding: 8px 14px;
      border-radius: 7px;
      cursor: pointer;
    }
    .toolbar button.active {
      background: var(--xmind-root);
      color: #fff;
    }
    .hint {
      position: fixed;
      left: 14px;
      bottom: 12px;
      font: 400 12px/1 'PingFang SC', sans-serif;
      color: #b0b0bb;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <div class="toolbar" id="toolbar">
    <button data-dim="studio" class="active">厂商</button>
    <button data-dim="year">年份</button>
    <button data-dim="tag">标签</button>
    <button data-dim="kind">类型</button>
  </div>

  <svg id="mindmap"></svg>
  <div class="hint">滚轮缩放 / 拖拽平移</div>

  <pre id="mindmap-data" hidden>{JSON.stringify(data)}</pre>

  <script is:inline>
    (async function () {
      const { Transformer, Markmap } = window.markmap;
      if (!Transformer || !Markmap) {
        document.body.innerHTML =
          '<p style="font-family:sans-serif;padding:24px">导图依赖加载失败（需联网），请刷新重试。</p>';
        return;
      }

      const raw = document.getElementById('mindmap-data').textContent;
      const data = JSON.parse(raw);

      const palette = ['#fa8155', '#ffad36', '#b7c82b', '#0098b9', '#7574bc', '#a165a8'];
      const rootColor = '#1f2766';
      const linkShape = d3.linkHorizontal();

      function tint(hex, a) {
        const n = parseInt(hex.slice(1), 16);
        const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
        return `rgba(${r},${g},${b},${a})`;
      }

      // 每层节点套卡片（颜色随一级分支冻结）
      function decorate(root) {
        let seq = 0;
        function walk(node, depth) {
          if (depth === 0) {
            node.content = `<div class="mm-card mm-root">${node.content}</div>`;
          } else if (depth === 1) {
            const c = palette[seq++ % palette.length];
            node.content =
              `<div class="mm-card mm-main" style="color:${c};border-color:${tint(c, 0.55)};background-color:${tint(c, 0.10)}">${node.content}</div>`;
          } else if (depth === 2) {
            node.content = `<div class="mm-card mm-sub">${node.content}</div>`;
          } else {
            node.content = `<div class="mm-card mm-note">${node.content}</div>`;
          }
          (node.children || []).forEach((c) => walk(c, depth + 1));
        }
        walk(root, 0);
      }

      // 连线颜色：按一级分支序号冻结
      const branchOrd = new Map();
      let nextOrd = 0;
      function lineColor(d) {
        const depth = d.state && d.state.depth;
        if (!depth || depth <= 1) return rootColor;
        const branchId = (d.state.path || '').split('.')[1];
        if (!branchOrd.has(branchId)) branchOrd.set(branchId, nextOrd++);
        return palette[branchOrd.get(branchId) % palette.length];
      }

      const mm = new Markmap('#mindmap', {
        color: lineColor,
        lineWidth: () => 2,
        autoFit: true,
        fitRatio: 0.82,
        initialExpandLevel: -1,
        zoom: true,
        pan: true,
        duration: 0,
        paddingX: 18,
        spacingHorizontal: 88,
        spacingVertical: 14,
        nodeMinHeight: 34,
      });

      // 连线锚点改为垂直居中（markmap 默认在底边）
      function centerAnchors() {
        const svg = document.getElementById('mindmap');
        svg.querySelectorAll('path.markmap-link').forEach((p) => {
          const d = p.__data__;
          if (!d || !d.source || !d.target) return;
          const s = d.source.state && d.source.state.rect;
          const t = d.target.state && d.target.state.rect;
          if (!s || !t) return;
          const dd = linkShape({
            source: [s.x + s.width, s.y + s.height / 2],
            target: [t.x, t.y + t.height / 2],
          });
          if (p.getAttribute('d') !== dd) p.setAttribute('d', dd);
        });
        svg.querySelectorAll('g.markmap-node').forEach((g) => {
          const d = g.__data__;
          if (!d || !d.state || !d.state.rect) return;
          const h = d.state.rect.height;
          const line = g.querySelector('line');
          if (line) {
            if (line.getAttribute('y1') !== String(h / 2)) line.setAttribute('y1', h / 2);
            if (line.getAttribute('y2') !== String(h / 2)) line.setAttribute('y2', h / 2);
          }
          const c = g.querySelector('circle');
          if (c && c.getAttribute('cy') !== String(h / 2)) c.setAttribute('cy', h / 2);
        });
      }

      function render(md) {
        branchOrd.clear();
        nextOrd = 0;
        const { root } = new Transformer().transform(md);
        decorate(root);
        mm.setData(root).then(() => centerAnchors());
      }

      document.querySelectorAll('#toolbar button').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#toolbar button').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          render(data[btn.dataset.dim]);
        });
      });

      render(data.studio);

      const mo = new MutationObserver(() => requestAnimationFrame(centerAnchors));
      mo.observe(document.getElementById('mindmap'), {
        attributes: true,
        subtree: true,
        attributeFilter: ['d', 'y1', 'y2', 'cy'],
      });
    })();
  </script>
</body>
</html>
