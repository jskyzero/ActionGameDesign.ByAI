---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://jskyzero.github.io';

const entries = (await getCollection('docs'))
  .filter((e) => e.id !== 'index.mdx' && !e.id.endsWith('/index.mdx'))
  .map((e) => {
    const d = e.data;
    const tags = (d.article.tags ?? [])
      .map((t) => `${t.icon ? t.icon + ' ' : ''}${t.label}`)
      .join(' / ');
    const author = [d.source?.author, d.source?.company, d.source?.year]
      .filter((v) => v !== undefined && v !== null && v !== '')
      .join(' / ');
    return {
      title: d.article.title,
      insight: d.article.insight ?? d.description ?? '',
      tags,
      author,
      sourceTitle: d.source?.title ?? '',
      url: d.source?.url ?? '',
      kbUrl: `${site}${base}/${e.slug}/`,
      year: d.source?.year,
    };
  })
  .sort((a, b) => {
    const av = typeof a.year === 'number' ? a.year : -Infinity;
    const bv = typeof b.year === 'number' ? b.year : -Infinity;
    return bv - av;
  });
---

<Base title="文章表格" contentWidth="880px">
  <div class="wrap">
    <header class="hero">
      <h1><span class="title-hl">文章表格</span></h1>
      <p class="sub">当前共 {entries.length} 篇。</p>
    </header>

    {entries.map((e) => (
      <table>
        <tbody>
          <tr><th>中文标题</th><td><span class="title-hl">{e.title}</span></td></tr>
          <tr><th>作者</th><td>{e.author}</td></tr>
          <tr><th>内容简介</th><td>{e.insight}</td></tr>
          <tr><th>标签</th><td>{e.tags}</td></tr>
          <tr><th>原文标题</th><td>{e.sourceTitle}</td></tr>
          <tr><th>原链接</th><td>{e.url ? <a href={e.url} target="_blank" rel="noopener">{e.url}</a> : ''}</td></tr>
          <tr><th>知识库总结</th><td><a href={e.kbUrl}>{e.kbUrl}</a></td></tr>
        </tbody>
      </table>
    ))}
  </div>
</Base>

<style>
  .wrap {
    max-width: var(--content-width);
    margin: 0 auto;
  }
  .hero {
    margin: 0 0 28px;
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: 1px;
    color: var(--ink);
  }
  .hero .sub {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
    margin: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    margin: 0 0 16px;
    font-size: 14px;
  }
  th,
  td {
    padding: 10px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }
  th {
    width: 96px;
    white-space: nowrap;
    color: var(--muted);
    font-weight: 500;
  }
  td {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  td a {
    color: var(--primary);
    border-bottom: 1px solid rgba(38, 38, 79, 0.25);
  }
  td a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
