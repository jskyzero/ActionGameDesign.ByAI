---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCover from '../components/ArticleCover.astro';
import Hook from '../components/Hook.astro';
import InfoCard from '../components/InfoCard.astro';
import CorePoints from '../components/CorePoints.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries
    .filter((e) => e.id !== 'index.mdx' && !e.id.endsWith('/index.mdx'))
    .map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.description}>
  <article class="article">
    <ArticleCover
      title={d.title}
      source={d.source}
      section={d.section}
      year={d.year}
      author={d.author}
      role={d.role}
      project={d.project}
    />
    <Hook insight={d.insight} />
    <InfoCard author={d.author} role={d.role} sourceTitle={d.sourceTitle} link={d.link} references={d.references} />
    <CorePoints points={d.corePoints} />
    <div class="prose">
      <Content />
    </div>
    {d.tags?.length > 0 && (
      <div class="tags">
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
  </article>
</Base>

<style>
  .article {
    max-width: 760px;
    margin: 0 auto;
    padding: 44px 24px 96px;
  }
  .prose {
    margin-top: 24px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .tag {
    font-size: 12px;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--line);
    padding: 4px 12px;
    border-radius: var(--r-pill);
  }
</style>
