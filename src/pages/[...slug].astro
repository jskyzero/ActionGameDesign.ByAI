---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCover from '../components/ArticleCover.astro';
import Hook from '../components/Hook.astro';
import InfoCard from '../components/InfoCard.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries
    .filter((e) => e.id !== 'index.mdx' && !e.id.endsWith('/index.mdx'))
    .map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content, headings = [] } = await render(entry);
const d = entry.data;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const transitionName = 'card-' + entry.slug.replace(/[^a-zA-Z0-9_-]+/g, '-');
---

<Base title={d.title} description={d.description}>
  <div class="page-grid">
    <article class="article">
      <div class="main">
        <ArticleCover
          title={d.title}
          event={d.event}
          section={d.section}
          year={d.year}
          author={d.author}
          role={d.role}
          project={d.project}
          tags={d.tags}
          transitionName={transitionName}
        />
        <Hook insight={d.insight} />
        <InfoCard author={d.author} role={d.role} titleOriginal={d.titleOriginal} link={d.link} references={d.references} />
        <div class="prose">
          <Content />
        </div>
        {d.tags?.length > 0 && (
          <div class="tags">
            {d.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        )}
      </div>
    </article>

    {tocItems.length > 0 && (
      <aside class="toc">
        <a class="back" href={`${base}/`}>← 返回首页</a>
        <div class="toc-title">目录</div>
        <nav>
          {tocItems.map((h) => (
            <a href={`#${h.slug}`} class={h.depth === 3 ? 'h3' : ''}>{h.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</Base>

<script>
  const links = Array.from(document.querySelectorAll('.toc nav a'));
  const heads = Array.from(document.querySelectorAll('.prose h2, .prose h3'));
  if (links.length && heads.length) {
    const io = new IntersectionObserver(
      (es) => {
        es.forEach((en) => {
          if (en.isIntersecting) {
            const href = '#' + en.target.id;
            links.forEach((l) => l.classList.toggle('active', l.getAttribute('href') === href));
          }
        });
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
    );
    heads.forEach((h) => io.observe(h));
  }
</script>

<style>
  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--content-width)) minmax(0, 1fr);
    grid-template-areas: '. main toc';
  }
  .article {
    grid-area: main;
    min-width: 0;
  }
  .main {
    min-width: 0;
  }
  .back {
    display: block;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 13px;
    transition: color 0.15s;
  }
  .back:hover {
    color: var(--primary);
  }
  .prose {
    margin-top: 24px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .tag {
    font-size: 12px;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--line);
    padding: 4px 12px;
    border-radius: var(--r-pill);
  }

  /* 右侧目录 */
  .toc {
    grid-area: toc;
    width: 200px;
    position: sticky;
    top: 40px;
    align-self: start;
    justify-self: start;
    padding-left: 28px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    font-size: 13px;
  }
  .toc-title {
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 10px;
  }
  .toc .back {
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--line);
  }
  .toc nav a {
    display: block;
    color: var(--muted);
    padding: 4px 0;
    line-height: 1.5;
  }
  .toc nav a:hover {
    color: var(--primary);
  }
  .toc nav a.active {
    position: relative;
    color: var(--primary);
    font-weight: 600;
  }
  .toc nav a.active::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 4px;
    bottom: 4px;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
  }
  .toc nav a.h3 {
    padding-left: 12px;
    font-size: 12px;
  }
  @media (max-width: 1080px) {
    .toc {
      display: none;
    }
  }
</style>
