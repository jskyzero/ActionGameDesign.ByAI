---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCover from '../components/ArticleCover.astro';
import Hook from '../components/Hook.astro';
import InfoCard from '../components/InfoCard.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries
    .filter((e) => e.id !== 'index.mdx' && !e.id.endsWith('/index.mdx'))
    .map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content, headings = [] } = await render(entry);
const d = entry.data;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={d.title} description={d.description}>
  <article class="article">
    <div class="main">
      <a class="back" href={`${base}/`}>← 返回首页</a>
      <ArticleCover
        title={d.title}
        source={d.source}
        section={d.section}
        year={d.year}
        author={d.author}
        role={d.role}
        project={d.project}
      />
      <Hook insight={d.insight} />
      <InfoCard author={d.author} role={d.role} sourceTitle={d.sourceTitle} link={d.link} references={d.references} />
      <div class="prose">
        <Content />
      </div>
      {d.tags?.length > 0 && (
        <div class="tags">
          {d.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}
    </div>

    {tocItems.length > 0 && (
      <aside class="toc">
        <div class="toc-title">目录</div>
        <nav>
          {tocItems.map((h) => (
            <a href={`#${h.slug}`} class={h.depth === 3 ? 'h3' : ''}>{h.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </article>
</Base>

<style>
  .article {
    max-width: 1000px;
    margin: 0 auto;
    padding: 32px 24px 96px;
    display: flex;
    gap: 48px;
  }
  .main {
    flex: 1;
    min-width: 0;
    max-width: var(--content-width, 760px);
  }
  .back {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 14px;
    transition: color 0.15s;
  }
  .back:hover {
    color: var(--indigo);
  }
  .prose {
    margin-top: 24px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .tag {
    font-size: 12px;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--line);
    padding: 4px 12px;
    border-radius: var(--r-pill);
  }

  /* 右侧目录 */
  .toc {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 40px;
    align-self: flex-start;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    border-left: 1px solid var(--line);
    padding-left: 20px;
    font-size: 13px;
  }
  .toc-title {
    font-weight: 600;
    color: var(--indigo);
    margin-bottom: 10px;
  }
  .toc nav a {
    display: block;
    color: var(--muted);
    padding: 4px 0;
    line-height: 1.5;
  }
  .toc nav a:hover {
    color: var(--indigo);
  }
  .toc nav a.h3 {
    padding-left: 12px;
    font-size: 12px;
  }
  @media (max-width: 900px) {
    .toc {
      display: none;
    }
  }
</style>
