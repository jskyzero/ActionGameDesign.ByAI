---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCover from '../components/ArticleCover.astro';
import Hook from '../components/Hook.astro';
import InfoCard from '../components/InfoCard.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries
    .filter((e) => e.id !== 'index.mdx' && !e.id.endsWith('/index.mdx'))
    .map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content, headings = [] } = await render(entry);
const d = entry.data;
const generatedDate = d.generation ? new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
}).format(new Date(d.generation.generatedAt)) : undefined;
const title = d.article.title;
const tags = d.article.tags ?? [];
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const transitionName = 'card-' + entry.slug.replace(/[^a-zA-Z0-9_-]+/g, '-');
---

<Base title={title} description={d.description}>
  <div class="page-grid">
    <article class="article">
      <div class="main">
        <a class="back-mobile" href={`${base}/`}>← 返回首页</a>
        <ArticleCover
          title={title}
          description={d.description}
          wip={d.status === 'wip'}
          tags={tags}
          source={d.source}
          transitionName={transitionName}
        />
        <Hook insight={d.article.insight} />
        <InfoCard source={d.source} references={d.references} />
        <div class="prose">
          <Content />
        </div>
        {d.generation && (
          <p class="generation"><em>本文由 <a href={d.generation.modelUrl} target="_blank" rel="noopener">{d.generation.model}</a> 于 <time datetime={d.generation.generatedAt}>{generatedDate}</time> 生成</em></p>
        )}
      </div>
    </article>

    <aside class="toc">
        <a class="back" href={`${base}/`}>← 返回首页</a>
        {tocItems.length > 0 && <div class="toc-title">目录</div>}
        <nav>
          {tocItems.map((h) => (
            <a href={`#${h.slug}`} class={h.depth === 3 ? 'h3' : ''}>{h.text}</a>
          ))}
        </nav>
    </aside>
  </div>
</Base>

<script>
  let io: IntersectionObserver | undefined;
  function observe() {
    io?.disconnect();
    const links = Array.from(document.querySelectorAll('.toc nav a'));
    const heads = Array.from(document.querySelectorAll('.prose h2, .prose h3'));
    if (links.length && heads.length) {
      io = new IntersectionObserver(
        (es) => {
          es.forEach((en) => {
            if (en.isIntersecting) {
              const href = '#' + en.target.id;
              links.forEach((l) => l.classList.toggle('active', l.getAttribute('href') === href));
            }
          });
        },
        { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
      );
      heads.forEach((h) => io!.observe(h));
    }
  }
  document.addEventListener('astro:page-load', observe);
  document.addEventListener('astro:before-swap', () => io?.disconnect());
</script>

<style>
  .generation {
    margin: 24px 0 0;
    text-align: right;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
  }
  .generation a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--content-width)) minmax(0, 1fr);
    grid-template-areas: '. main toc';
  }
  .article {
    grid-area: main;
    min-width: 0;
  }
  .main {
    min-width: 0;
  }
  .back {
    display: block;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 13px;
    transition: color 0.15s;
  }
  .back:hover {
    color: var(--primary);
  }
  .back-mobile {
    display: none;
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 10px;
    transition: color 0.15s;
  }
  .back-mobile:hover {
    color: var(--primary);
  }
  .prose {
    margin-top: 24px;
  }

  /* 右侧目录 */
  .toc {
    grid-area: toc;
    /* 保持左侧锚点，向右利用空白；宽度包含 28px 内边距。 */
    width: min(320px, 100%);
    position: sticky;
    top: 40px;
    align-self: start;
    justify-self: start;
    padding-left: 28px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    font-size: 13px;
  }
  .toc-title {
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 10px;
  }
  .toc .back {
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--line);
  }
  .toc nav a {
    display: block;
    color: var(--muted);
    padding: 4px 0;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .toc nav a:hover {
    color: var(--primary);
  }
  .toc nav a.active {
    position: relative;
    color: var(--primary);
    font-weight: 600;
  }
  .toc nav a.active::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 4px;
    bottom: 4px;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
  }
  .toc nav a.h3 {
    padding-left: 12px;
    font-size: 12px;
  }
  /* 正文 880px + 两侧各 200px + 页面内边距 48px。 */
  @media (max-width: 1328px) {
    .toc {
      display: none;
    }
    .back-mobile {
      display: inline-block;
    }
  }
</style>
